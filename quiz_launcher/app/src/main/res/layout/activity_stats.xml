<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9 题库统计页：学科汇总 + 逐题列表 + 手动移出/恢复/重置 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="96dp"
        android:paddingTop="44dp"
        android:paddingRight="96dp"
        android:paddingBottom="44dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="68dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="题库统计"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stats_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_restore_all"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/button_bg"
                    android:fontFamily="sans-serif"
                    android:minHeight="0dp"
                    android:minWidth="230dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="恢复全部已移出"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_reset_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/button_bg"
                    android:fontFamily="sans-serif"
                    android:minHeight="0dp"
                    android:minWidth="180dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="重置统计"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_strict_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/button_bg"
                    android:fontFamily="sans-serif"
                    android:minHeight="0dp"
                    android:minWidth="250dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="严格模式（需 PIN）"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 学科汇总 -->
            <LinearLayout
                android:id="@+id/subject_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:text="逐题列表（点击可移出 / 恢复）"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/question_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/stats_exit"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="96dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/badge_bg"
        android:contentDescription="返回"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:text="‹"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />
</FrameLayout>
